type blob1 = struct {#a:int};
type blob2 = struct {#a:int, #b:int};
type blob3 = struct {#a:int, #b:int, #c:int};
let x:blob1 = {#a = 2};
let y:blob2 = {#a = 3, #b = 4};
let z:blob3 = {#a = 5, #b = 6, #c = 7};
let l:list<blob1> = cons(y, nil);
l;;

